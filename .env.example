# Copy this file to ".env" and adjust as needed. The .env file itself
# should NEVER be committed to version control (it's where real API keys
# would live if you ever switch to a paid provider).

# Port the backend server listens on. The frontend's AI_CONFIG.apiBaseUrl
# in script.js must match this (default http://localhost:3000).
PORT=3000

# Which AI provider module to use. Built-in options:
#   ollama - talk to a locally running Ollama server (free, no API key)
#   mock   - canned responses, useful for testing the UI without any AI
#            model installed at all
AI_PROVIDER=ollama

# --- Ollama provider settings (only used when AI_PROVIDER=ollama) ---
# Base URL of your local Ollama server (this is Ollama's default).
OLLAMA_BASE_URL=http://localhost:11434
# Any model you've pulled with `ollama pull <name>`. llama3.1 and phi3 are
# good free, lightweight choices for a study-assistant use case.
OLLAMA_MODEL=llama3.1

# Comma-separated list of frontend origins allowed to call this backend.
# If you open index.html directly as a file:// URL, or serve it from the
# same backend (recommended, see README), CORS usually isn't even an issue.
# Add your dev server's origin here if you serve the frontend separately,
# e.g. http://127.0.0.1:5500 for VS Code Live Server.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000
